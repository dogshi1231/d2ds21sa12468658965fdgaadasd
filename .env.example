# Discord Bot Configuration
DISCORD_TOKEN=your_bot_token_here
DISCORD_SECRET=your_bot_secret_here

# Database Configuration
# Options: sqlite, postgresql, mysql
DB_PROVIDER=sqlite
DB_CONNECTION_URL=file:./data/database.sqlite

# For PostgreSQL (recommended for Railway):
# DB_PROVIDER=postgresql
# DB_CONNECTION_URL=postgresql://username:password@host:port/database

# For MySQL:
# DB_PROVIDER=mysql
# DB_CONNECTION_URL=mysql://username:password@host:port/database

# Encryption
ENCRYPTION_KEY=generate_with_npm_run_keygen
DISABLE_ENCRYPTION=false

# Bot Owner/Admin User ID
SUPER=your_discord_user_id

# Environment
NODE_ENV=production

# Command Publishing
PUBLISH_COMMANDS=true

# HTTP Server
HTTP_EXTERNAL=https://your-railway-domain.up.railway.app
HTTP_PORT=8169
HTTP_HOST=0.0.0.0

# Optional: Sentry Error Tracking
# SENTRY_DSN=your_sentry_dsn_here
